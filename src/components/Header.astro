---
import ThemeLogo from './ThemeLogo.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label="JdexStudio, inicio"><ThemeLogo /></a>
        <nav class="desktop-nav" aria-label="Navegación principal">
          <a href="#servicios">Servicios</a><a href="#proceso">Cómo trabajamos</a><a href="#equipo">Equipo</a>
        </nav>
        <ThemeToggle />
        <a class="header-cta button button-primary" href="#contacto" data-booking><svg class="icon" aria-hidden="true"><use href="#calendar" /></svg>Agendar una consulta <svg class="icon" aria-hidden="true"><use href="#arrow-up-right" /></svg></a>
        <details class="mobile-menu">
          <summary aria-label="Menú de navegación"><span class="menu-lines" aria-hidden="true"></span><span>Menú</span></summary>
          <nav aria-label="Navegación móvil"><a href="#servicios">Servicios</a><a href="#proceso">Cómo trabajamos</a><a href="#equipo">Equipo</a><a href="#contacto">Contacto</a><a href="#contacto" data-booking><svg class="icon" aria-hidden="true"><use href="#calendar" /></svg>Agendar una consulta</a></nav>
        </details>
      </div>
    </header>
